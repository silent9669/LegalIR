# ==============================================================================
# LegalIR Production Environment Variables (.env)
# Copy this file to .env and fill in your personal credentials before running.
# ==============================================================================

# Hugging Face Access Token with WRITE permissions (for model export)
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_write_token_here
HF_TOKEN_WRITE=hf_your_huggingface_write_token_here

# Kaggle API Credentials (for downloading canonical Task 1 clean data)
# Create at: https://www.kaggle.com/settings -> Create New Token
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_key_here

# Hugging Face repo nhận artifacts: repo PUBLIC có chủ ý của LegalIR để ban
# giám khảo xác minh. KHÔNG tự đổi sang private, tạo repo khác, hay để preflight
# tạo repo mới nếu chưa được phép riêng. Production đi kèm --hf-allow-public-repo
# và token của bạn phải có quyền WRITE trên đúng repo này.
# HF_REPO_ID=dangphuc2109/legalir-task1-reranker

# Optional: Modal Secret Names (configured in your Modal Cloud Dashboard)
# - kaggle-secret (KAGGLE_USERNAME, KAGGLE_KEY)
# - huggingface-secret (HF_TOKEN)
